-- luacheck config for AuctionHelper. Run through `npm run lint` (scripts/lint.py),
-- which compares results against scripts/lint-baseline.json (ratchet).
-- New WoW API used in code? Add it to read_globals below (alphabetical).

std = "lua51"
max_line_length = 160
codes = true
cache = true -- .luacheckcache (gitignored) makes repeat runs fast

ignore = {
	"212/self", -- WoW callbacks and mixins receive self even when unused
	"432/self", -- script handlers inside methods name the frame `self` (WoW idiom)
	"211/_.*", -- underscore-prefixed locals are intentionally unused
	"212/_.*",
	"213/_.*",
}

-- Globals the addon owns and writes: SavedVariables (see TOCs) and slash commands.
globals = {
	"AuctionHelperAuctionDB",
	"AuctionHelperBagsDB",
	"AuctionHelperDB",
	"AuctionHelperInventoryDB",
	"AuctionHelperLastExport",
	"AuctionHelperMigrationDB",
	"AuctionHelperProfessionsDB",
	"ProfessionExporterDB",
	"ProfessionExporterLastExport",
	"SLASH_PROFESSIONEXPORTER1",
	"SLASH_AHFARM1",
	"SLASH_PROFESSIONEXPORTER2",
	"SlashCmdList",
	"UISpecialFrames",
}

-- WoW client API, frames and constants, plus optional third-party addons.
