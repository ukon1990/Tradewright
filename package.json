{
  "name": "tradewright",
  "version": "2.0.0",
  "private": true,
  "description": "Tradewright World of Warcraft addon pack (Forever + retail)",
  "type": "module",
  "scripts": {
    "deploy:local": "node scripts/deploy.mjs",
    "deploy:forever": "node scripts/deploy.mjs forever",
    "deploy:retail": "node scripts/deploy.mjs retail",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "migrate:saved-data": "node scripts/migrate-saved-data.mjs",
    "sources:build": "node scripts/build-source-data.mjs",
    "test": "python3 src/Tradewright/tests/run_tests.py && python3 scripts/lint.py",
    "lint": "python3 scripts/lint.py",
    "lint:baseline": "python3 scripts/lint.py --update-baseline"
  }
}
